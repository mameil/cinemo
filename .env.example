TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token
TMDB_API_KEY=your-tmdb-api-key
TMDB_ACCESS_TOKEN=your-tmdb-access-token
KOBIS_API_KEY=your-kobis-api-key
# CGV Cloudflare 우회용 (lexiforest/curl-impersonate 릴리스 바이너리 경로)
CURL_IMPERSONATE_BIN=/Users/you/.local/bin/curl-impersonate
# 예매 오픈 알람 폰 푸시 (ntfy.sh) — 토픽을 아는 사람은 누구나 구독 가능하므로
# 추측 불가한 랜덤 문자열을 쓸 것: openssl rand -hex 10
WATCH_NTFY_TOPIC=cinemo-cgv-여기에랜덤문자열
